# --- Back-end (FastAPI) ---
# anthropic = LLM real (precisa da chave) · simulado = regras por palavra-chave, só para demonstrar sem chave
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=30
# Origens permitidas no CORS, separadas por vírgula. '*' é recusado pela API.
ALLOWED_ORIGINS=http://localhost:8501
DB_PATH=dados/ouviai.db
# carrega a semana de demonstração do OuviAí (mesmos eventos do Robô Cuidador) se o banco estiver vazio
SEED_DEMO=true
CONFIANCA_MINIMA_EVENTO=0.60
# Modelo de fissuras treinado no Colab (opcional)
MODEL_PATH=models/modelo.keras
LIMIAR_FISSURA=0.5

# --- Front-end (Streamlit) ---
API_URL=http://localhost:8000
